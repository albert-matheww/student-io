# Copy to .env and fill in real values. Nothing here is required to boot the
# API locally — every integration has a local-dev fallback (see the comments
# in app/core/config.py and app/services/*) — but real keys are required for
# auth, AI generation, and cloud storage to actually work.

ENVIRONMENT=development

# Postgres (matches docker-compose.yml — override if using managed Supabase Postgres)
DATABASE_URL=postgresql+psycopg://student_io:student_io_dev@localhost:5442/student_io
REDIS_URL=redis://localhost:6379/0

# Clerk — https://dashboard.clerk.com → API Keys
# CLERK_ISSUER looks like https://your-app-name.clerk.accounts.dev
CLERK_ISSUER=
CLERK_SECRET_KEY=

# AI — Gemini is preferred (free tier at https://aistudio.google.com/apikey).
# Falls back to Groq (free, chat + transcription only), then OpenAI (paid).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq — https://console.groq.com/keys (free, no card required)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# OpenAI — https://platform.openai.com/api-keys (optional, paid, last resort)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Supabase — https://app.supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=student-io-resources

# YouTube Data API — https://console.cloud.google.com (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# Sentry — https://sentry.io (free tier). No-op when unset.
SENTRY_DSN=

CORS_ORIGINS=["http://localhost:3000"]
