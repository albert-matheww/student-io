# Copy to .env.local and fill in real values.
# The app boots and renders without these — auth just stays signed out and
# API calls hit the local FastAPI dev server.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk — https://dashboard.clerk.com → API Keys (must match apps/api/.env CLERK_ISSUER)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Sentry — https://sentry.io (free tier). No-op when unset.
NEXT_PUBLIC_SENTRY_DSN=
